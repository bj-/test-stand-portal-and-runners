POSTGRES_PASSWORD=
# Адрес, на котором слушает портал
PORTAL_BIND=127.0.0.1:8080
# Каталог с клонами репозиториев результатов на хосте
RESULTS_ROOT=./data/results
# Реестр базовых образов сборки, если Docker Hub недоступен: mirror.gcr.io/library
BASE_REGISTRY=docker.io/library
# Каталог данных (БД)
PORTAL_DATA=./data
# Файл проектов
PROJECTS_FILE=./projects.yaml
# true - когда портал за HTTPS
PORTAL_COOKIE_SECURE=false
# Часовой пояс хоста для полуночной проверки сроков стендов
# TZ=Europe/Moscow
